---
import type { Translations } from '@/i18n';
import AgentLogoMarquee from './AgentLogoMarquee.tsx';
import './LogoLoop/LogoLoop.css';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="py-14">
  <div class="mx-auto max-w-6xl px-6">
    <p class="mb-3 text-center text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)] animate-on-scroll">
      {t.integrations.heading}
    </p>
    <p class="mx-auto mb-8 max-w-2xl text-center text-sm leading-relaxed text-[var(--color-muted)] animate-on-scroll">
      {t.integrations.subheading}
    </p>
  </div>
  <AgentLogoMarquee
    client:visible
    ariaLabelA={t.integrations.loopAriaA}
    ariaLabelB={t.integrations.loopAriaB}
  />
  <p class="mt-6 text-center text-xs tracking-wide text-[var(--color-muted)]">
    {t.integrations.caption}
  </p>
</section>

<style>
  :global(.agent-marquee) {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 0 0.5rem;
  }

  :global(.agent-marquee .logoloop) {
    width: 100%;
  }

  :global(.agent-marquee .logoloop__item img) {
    opacity: 0.94;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  :global(.agent-marquee .logoloop__item:hover img),
  :global(.agent-marquee .logoloop__item:focus-within img) {
    opacity: 1;
  }

  :global(.agent-marquee .logoloop__tip) {
    color: var(--color-primary-deep);
    font-family: var(--font-body, inherit);
  }
</style>
