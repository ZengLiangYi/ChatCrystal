{
  "name": "chatcrystal",
  "version": "0.6.0",
  "mcpName": "io.github.ZengLiangYi/chatcrystal",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZengLiangYi/ChatCrystal"
  },
  "homepage": "https://zengliangyi.github.io/ChatCrystal/",
  "description": "Local-first AI PKM for coding conversations — supports Claude Code, Cursor, Codex CLI, Trae, GitHub Copilot",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "conversation",
    "knowledge",
    "knowledge-base",
    "pkm",
    "personal-knowledge-management",
    "personal-knowledge-base",
    "note-taking",
    "mcp",
    "semantic-search",
    "notes",
    "codex",
    "cursor",
    "electron",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "crystal": "dist/server/src/cli/index.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-seed-data.mjs",
    "check:npm-package": "node scripts/check-npm-package.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "start": "node dist/server/src/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "eval:experience": "tsx scripts/evaluate-experience-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/azure": "4.0.60",
    "@ai-sdk/google": "4.0.63",
    "@ai-sdk/openai": "4.0.57",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "7.0.91",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fastify": "5.12.2",
    "ink": "^7.1.1",
    "p-queue": "^9.3.3",
    "react": "^19.2.8",
    "sql.js": "^1.14.2",
    "vectra": "^0.15.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@chatcrystal/shared": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/sql.js": "^1.4.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "^4.23.13"
  }
}
