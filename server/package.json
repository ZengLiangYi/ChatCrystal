{
  "name": "chatcrystal",
  "version": "0.7.1",
  "mcpName": "io.github.ZengLiangYi/chatcrystal",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZengLiangYi/ChatCrystal"
  },
  "homepage": "https://zengliangyi.github.io/ChatCrystal/",
  "author": {
    "name": "Zeng Liangyi",
    "url": "https://zengliangyi.com"
  },
  "description": "Local-first AI PKM for coding conversations — imports 32 AI coding agent harnesses (Claude Code, Claude Desktop, Codex CLI, Cursor, Copilot, Gemini CLI, Qwen Code, OpenCode, Pi, Kimi Code and more), locally and from WSL",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "conversation",
    "knowledge",
    "knowledge-base",
    "pkm",
    "personal-knowledge-management",
    "personal-knowledge-base",
    "note-taking",
    "mcp",
    "semantic-search",
    "notes",
    "codex",
    "cursor",
    "electron",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "crystal": "dist/server/src/cli/index.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-seed-data.mjs",
    "check:npm-package": "node scripts/check-npm-package.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "start": "node dist/server/src/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "eval:experience": "tsx scripts/evaluate-experience-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/azure": "4.0.119",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai": "4.0.111",
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "7.0.166",
    "chokidar": "^5.0.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "fastify": "5.12.8",
    "ink": "^7.1.1",
    "p-queue": "^9.3.3",
    "react": "^19.3.1",
    "sql.js": "^1.15.2",
    "vectra": "^0.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chatcrystal/shared": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "^4.23.15"
  }
}
